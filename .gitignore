# Build output
/bin/

# Go test binaries (pkg.test), but not directories named like sample
# sites (daily-herald.test/)
*.test
!*.test/

# Go profiling and coverage
*.out
coverage.*

# Local environment
.env
.DS_Store

# Benchmark data: the corpus is CC BY-SA (Wikipedia) and large; caches are local
/bench/corpus/
/bench/.cache/
# LibreOffice lock files (E7 score sheets)
.~lock.*#
